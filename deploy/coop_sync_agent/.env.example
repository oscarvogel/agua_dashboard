# Copiar este archivo como .env dentro de la computadora de la cooperativa.
# No compartir ni subir este archivo con credenciales reales.

# Base operativa local de la cooperativa. Usuario recomendado: solo SELECT.
COOP_MYSQL_HOST=127.0.0.1
COOP_MYSQL_PORT=3306
COOP_MYSQL_DATABASE=agua
COOP_MYSQL_USER=
COOP_MYSQL_PASSWORD=
COOP_MYSQL_SSL_MODE=disabled

# Base destino VPS del dashboard. Usuario recomendado: escritura solo sobre la copia.
VPS_MYSQL_HOST=
VPS_MYSQL_PORT=3306
VPS_MYSQL_DATABASE=agua_dashboard
VPS_MYSQL_USER=
VPS_MYSQL_PASSWORD=
VPS_MYSQL_SSL_MODE=preferred

# Modo simple por mysqldump/mysql para Windows 7.
# Requiere mysqldump.exe y mysql.exe instalados en la PC.
# Si no estan en PATH, indicar carpeta bin de MySQL, por ejemplo:
# MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 5.7\bin
MYSQL_BIN_DIR=
MYSQL_CHARSET=utf8
SIMPLE_SYNC_TABLES=clientes conexiones consumo cabfact detfact ctacte movcaja pendfact conceptos tablas

server {
    listen 80;
    server_name agua.vogelconsultoria.com.ar;

    # Redirigir a HTTPS despues de emitir el certificado.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name agua.vogelconsultoria.com.ar;

    ssl_certificate /etc/letsencrypt/live/agua.vogelconsultoria.com.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agua.vogelconsultoria.com.ar/privkey.pem;

    root /home/ferreteria/agua_dashboard_test/frontend_dist;
    index index.html;

    access_log /var/log/nginx/agua-dashboard.access.log;
    error_log /var/log/nginx/agua-dashboard.error.log;

    location /api/ {
        proxy_pass http://127.0.0.1:8010/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

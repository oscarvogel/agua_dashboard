# Copiar este archivo como .env y completar los valores reales.
# No subir .env al repositorio.

# Cooperativa source database, read-only.
# Usuario recomendado: solo SELECT sobre la base operativa `agua`.
COOP_MYSQL_HOST=
COOP_MYSQL_PORT=3306
COOP_MYSQL_DATABASE=agua
COOP_MYSQL_USER=
COOP_MYSQL_PASSWORD=
COOP_MYSQL_SSL_MODE=preferred

# VPS dashboard database.
# Usuario recomendado para sync: permisos de escritura sobre la copia `agua_dashboard`.
VPS_MYSQL_HOST=
VPS_MYSQL_PORT=3306
VPS_MYSQL_DATABASE=agua_dashboard
VPS_MYSQL_USER=
VPS_MYSQL_PASSWORD=
VPS_MYSQL_SSL_MODE=preferred

# Cliente MySQL legacy para Windows 7.
# MySQL 6.0 puede no soportar utf8mb4.
MYSQL_CHARSET=utf8
MYSQL_BIN_DIR=

# Dashboard Django/API.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DASHBOARD_TOKEN_MAX_AGE=28800

# Usuario inicial del dashboard.
# Usar una clave fuerte antes de publicar.
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=

# SMTP para envios operativos.
# Para el llamado a asamblea se usa como remitente visible info@vogelconsultoria.com.ar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
SMTP_FROM_EMAIL=info@vogelconsultoria.com.ar
SMTP_FROM_NAME=Vogel Consultoria
SMTP_REPLY_TO=info@vogelconsultoria.com.ar
SMTP_HOURLY_LIMIT=100
